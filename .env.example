# Foundry VTT license key (required for first-time setup)
FOUNDRY_LICENSE_KEY=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX

# Port for Foundry to listen on
FOUNDRY_PORT=30000

# Admin password (optional, defaults to "test-admin")
# FOUNDRY_ADMIN_PASSWORD=test-admin

# Valeros character UUIDs for integration tests (optional)
# VALEROS_L1_UUID=
# VALEROS_L3_UUID=
# VALEROS_L5_UUID=a5884413-857f-444c-a5d6-24d819632c8a
