STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.js' '*.json' '*.md' '*.yml')
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs npx prettier --write --cache
  echo "$STAGED_FILES" | xargs git add
fi
if git diff --cached --name-only --diff-filter=ACMR -- 'docs/*.md' | grep -q .; then
  npm run validate:mermaid
fi
npm run lint
npm test
