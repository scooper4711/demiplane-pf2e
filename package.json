{
  "name": "demiplane-pf2e",
  "version": "0.1.0",
  "description": "Foundry VTT module for two-way character sync between Demiplane Nexus and the PF2e system",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 5",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npx playwright test",
    "coverage:e2e": "node scripts/e2e-coverage.mjs",
    "start:foundry": "source .env && node \"${FOUNDRY_PATH:-./playwright/versions/14.367/FoundryVTT-Node-14.367}/main.mjs\" --dataPath=\"${FOUNDRY_DATA_PATH:-./playwright/Data}\" --port=\"${FOUNDRY_PORT:-30000}\" --adminPassword=\"${FOUNDRY_ADMIN_PASSWORD:-test-admin}\" --noupdate",
    "smoke": "./scripts/smoke-foundry.sh",
    "dev": "npm run build && npm run start:foundry",
    "foundry": "./scripts/foundry.sh",
    "integration": "./scripts/foundry.sh test run",
    "check:duplication": "node scripts-build/check-duplication.cjs",
    "check:quality": "npm run lint && npm run check:duplication",
    "test:all": "npm run test && npm run check:quality",
    "validate:mermaid": "node scripts/validate-mermaid.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "foundry-vtt",
    "pf2e",
    "demiplane",
    "character-sync",
    "pathfinder"
  ],
  "author": "scooper4711",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scooper4711/demiplane-api": "^1.0.0",
    "tslib": "^2.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@dfreds/foundry-types": "^14.366.1",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "convert-source-map": "^2.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jscpd": "^5.1.2",
    "lint-staged": "^17.4.1",
    "nyc": "^18.0.0",
    "prettier": "^3.5.0",
    "rollup": "^4.40.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
